{
  "name": "orcher-sdk-ts",
  "version": "0.1.0",
  "private": true,
  "description": "ORCHER TypeScript SDK - Build durable, fault-tolerant workflows",
  "keywords": [
    "orcher",
    "workflow",
    "orchestration",
    "durable-execution",
    "typescript",
    "postgresql"
  ],
  "homepage": "https://orcher.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcher-io/sdk-ts.git"
  },
  "license": "Apache-2.0",
  "author": "ORCHER Contributors",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "build:native": "nx run @orcher/sdk:build:native",
    "build:ts": "nx run @orcher/sdk:build:ts",
    "clean": "nx run-many --target=clean --all && rm -rf node_modules dist",
    "dev": "nx run-many --target=dev --all --parallel=3",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all -- --fix",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "test:unit": "nx run-many --target=test:unit --all",
    "test:integration": "nx run-many --target=test:integration --all",
    "test:e2e": "nx run-many --target=test:e2e --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:coverage": "nx run-many --target=test --all --coverage",
    "type-check": "nx run-many --target=type-check --all",
    "type-check:affected": "nx affected --target=type-check",
    "proto:generate": "nx run @orcher/sdk:proto:generate",
    "docs": "typedoc",
    "docs:serve": "npm run docs && cd docs && python3 -m http.server",
    "examples": "nx run-many --target=examples --all",
    "graph": "nx graph",
    "reset": "nx reset",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "ci": "nx run-many --target=ci --all --parallel=3",
    "ci:affected": "nx affected --target=ci --base=origin/main"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.1",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nx": "^18.0.0",
    "@nx/js": "^18.0.0",
    "@nx/jest": "^18.0.0",
    "@nx/eslint-plugin": "^18.0.0",
    "@nx/workspace": "^18.0.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "nx": {
    "includedScripts": []
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
